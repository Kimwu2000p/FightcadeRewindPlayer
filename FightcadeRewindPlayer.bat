            private double ParseSecInput(string text, double defaultVal)
            {
                if (string.IsNullOrEmpty(text)) return defaultVal;
                text = text.Replace('\uFF1A', ':').Trim();
                if (text.Contains(":"))
                {
                    string[] parts = text.Split(':');
                    if (parts.Length == 2)
                    {
                        double m, s;
                        if (double.TryParse(parts[0], out m) && double.TryParse(parts[1], out s))
                            return Math.Max(0, m * 60.0 + s);
                    }
                }
                double val;
                if (double.TryParse(text, out val)) return Math.Max(0, val);
                return defaultVal;
            }

            private void OnSecInputChanged()
            {
                if (txtInSec == null || txtOutSec == null) return;
                double secIn = ParseSecInput(txtInSec.Text, 0);
                double secOut = ParseSecInput(txtOutSec.Text, 30);
                m_inFrame = (int)(secIn * 60.0);
                m_outFrame = (int)(secOut * 60.0);
                UpdateClipRangeUI();
            }

            private void UpdateClipRangeUI()
            {
                if (lblClipDuration == null) return;
                bool isClip = rbRecClip != null && rbRecClip.Checked;

                if (txtInSec != null) txtInSec.Enabled = isClip;
                if (txtOutSec != null) txtOutSec.Enabled = isClip;
                if (btnSetIn != null) btnSetIn.Enabled = isClip;
                if (btnSetOut != null) btnSetOut.Enabled = isClip;

                if (isClip)
                {
                    int diff = Math.Max(0, m_outFrame - m_inFrame);
                    double durSec = Math.Round(diff / 60.0, 1);
                    lblClipDuration.Text = durSec.ToString("0.#") + "s";
                    lblClipDuration.ForeColor = Color.FromArgb(160, 255, 180);
                }
                else
                {
                    lblClipDuration.Text = "Full";
                    lblClipDuration.ForeColor = Color.FromArgb(150, 190, 220);
                }
            }

            private string FormatFrameTime(int frames)
            {
                if (frames < 0) frames = 0;
                int totalSec = frames / 60;
                int m = totalSec / 60;
                int s = totalSec % 60;
                return string.Format("{0:D2}:{1:D2}", m, s);
            }

