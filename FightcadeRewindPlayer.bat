@echo off
setlocal EnableExtensions
title FightcadeRewindPlayer v1.0 - by Kim

set "APP_DIR=%~dp0"
if "%APP_DIR:~-1%"=="\" set "APP_DIR=%APP_DIR:~0,-1%"
cd /d "%APP_DIR%"

set "LAUNCHER_EXE=%APP_DIR%\FightcadeRewindPlayer.exe"

if exist "%LAUNCHER_EXE%" (
    start "" "%LAUNCHER_EXE%" "%APP_DIR%"
    exit /b
)

set "CSC_EXE="
if exist "%SystemRoot%\Microsoft.NET\Framework\v4.0.30319\csc.exe" set "CSC_EXE=%SystemRoot%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if "%CSC_EXE%"=="" if exist "%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\csc.exe" set "CSC_EXE=%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"

if "%CSC_EXE%"=="" (
    echo [ERROR] Cannot find .NET Framework 4.0 compiler.
    pause
    exit /b 1
)

echo [System] Initializing FightcadeRewindPlayer.exe...
set "CS_FILE=%APP_DIR%\RewindSource.cs"
more +40 "%~f0" > "%CS_FILE%"

set "ICO_OPT="
if exist "%APP_DIR%\FightcadeRewindPlayer.ico" set "ICO_OPT=/win32icon:%APP_DIR%\FightcadeRewindPlayer.ico"
"%CSC_EXE%" /nologo /target:winexe /optimize+ /platform:anycpu %ICO_OPT% /reference:System.dll,System.Windows.Forms.dll,System.Drawing.dll /out:"%LAUNCHER_EXE%" "%CS_FILE%"
if exist "%CS_FILE%" del /f /q "%CS_FILE%"
if errorlevel 1 (
    echo [ERROR] Compilation failed.
    pause
    exit /b 1
)

start "" "%LAUNCHER_EXE%" "%APP_DIR%"
