            private string GetCurrentGamePrefix()
            {
                string rawGame = null;
                try
                {
                    if (txtUrl != null && !string.IsNullOrEmpty(txtUrl.Text))
                    {
                        string u = txtUrl.Text.Trim();
                        Match mWeb = Regex.Match(u, @"replay\.fightcade\.com/[^/]+/([^/\s\?#]+)", RegexOptions.IgnoreCase);
                        if (mWeb.Success)
                        {
                            rawGame = mWeb.Groups[1].Value;
                        }
                        else
                        {
                            Match mFc = Regex.Match(u, @"fcade://stream/[^/]+/([^/\s\?#,]+)", RegexOptions.IgnoreCase);
                            if (mFc.Success) rawGame = mFc.Groups[1].Value;
                        }
                    }
                }
                catch { }
                if (string.IsNullOrEmpty(rawGame))
                {
                    rawGame = m_lastGameName;
                }
                if (!string.IsNullOrEmpty(rawGame))
                {
                    string clean = Regex.Replace(rawGame.Trim(), @"[^a-zA-Z0-9_\-]", "");
                    if (!string.IsNullOrEmpty(clean)) return clean;
                }
                return "Fightcade";
            }

