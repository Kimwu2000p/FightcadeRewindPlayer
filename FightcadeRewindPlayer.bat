            private string GetFbneoDir()
            {
                if (!string.IsNullOrEmpty(m_activeFbneoDir) && Directory.Exists(m_activeFbneoDir))
                    return m_activeFbneoDir;

                string p1 = Path.Combine(m_baseDir, @"emulator\fbneo");
                if (Directory.Exists(p1)) return p1;
                string p2 = Path.Combine(m_baseDir, "fbneo");
                if (Directory.Exists(p2)) return p2;
                return m_baseDir;
            }

            private System.Collections.Generic.List<string> GetTargetFbneoDirs()
            {
                var list = new System.Collections.Generic.List<string>();
                string primary = GetFbneoDir();
                if (!string.IsNullOrEmpty(primary) && Directory.Exists(primary) && !list.Contains(primary))
                    list.Add(primary);

                if (!string.IsNullOrEmpty(m_activeFbneoDir) && Directory.Exists(m_activeFbneoDir) && !list.Contains(m_activeFbneoDir))
                    list.Add(m_activeFbneoDir);

                try
                {
                    string pParent = Path.GetFullPath(Path.Combine(m_baseDir, @"..\emulator\fbneo"));
                    if (Directory.Exists(pParent) && !list.Contains(pParent))
                        list.Add(pParent);
                }
                catch { }

                return list;
            }

            private void FetchOfficialDurationFrames(string matchId)
            {
                if (string.IsNullOrEmpty(matchId)) return;
                new Thread(() =>
                {
                    try
                    {
                        ServicePointManager.SecurityProtocol = (SecurityProtocolType)3072; // TLS 1.2
                        HttpWebRequest req = (HttpWebRequest)WebRequest.Create("https://www.fightcade.com/api/");
                        req.Method = "POST";
                        req.ContentType = "application/json";
                        req.Timeout = 4000;
                        req.UserAgent = "FightcadeRewindPlayer/1.0";
                        string postData = "{\"req\":\"searchquarks\",\"quarkid\":\"" + matchId + "\"}";
                        byte[] bytes = Encoding.UTF8.GetBytes(postData);
                        req.ContentLength = bytes.Length;
                        using (Stream os = req.GetRequestStream())
                        {
                            os.Write(bytes, 0, bytes.Length);
                        }
                        using (HttpWebResponse resp = (HttpWebResponse)req.GetResponse())
                        using (StreamReader sr = new StreamReader(resp.GetResponseStream()))
                        {
                            string json = sr.ReadToEnd();
                            Match dm = Regex.Match(json, "\"duration\"\\s*:\\s*([0-9]+)");
                            if (dm.Success)
                            {
                                int durSecs = int.Parse(dm.Groups[1].Value);
                                if (durSecs > 0)
                                {
                                    int frames = (int)(durSecs * 59.2f);
                                    if (frames > 0)
                                    {
                                        m_apiTotalFrames = frames;
                                        this.BeginInvoke((Action)(() => RefreshDashboardText()));
                                    }
                                }
                            }
                        }
                    }
                    catch { }
                }) { IsBackground = true }.Start();
            }

