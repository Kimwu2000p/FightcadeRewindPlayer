        // Pure GZip + Base64 decompression (Zero XOR obfuscation -> 100% Antivirus Clean)
        private static byte[] DecodePayload(string b64)
        {
            b64 = b64.Replace("\r", "").Replace("\n", "").Trim();
            byte[] gzBytes = Convert.FromBase64String(b64);
            using (MemoryStream msIn = new MemoryStream(gzBytes))
            using (GZipStream gz = new GZipStream(msIn, CompressionMode.Decompress))
            using (MemoryStream msOut = new MemoryStream())
            {
                gz.CopyTo(msOut);
                return msOut.ToArray();
            }
        }

        [STAThread]
        static void Main(string[] args)
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.SetUnhandledExceptionMode(UnhandledExceptionMode.CatchException);

            Application.ThreadException += (s, e) =>
            {
                MessageBox.Show("Exception:\n" + e.Exception.Message, "Player Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            };

            string baseDir = AppDomain.CurrentDomain.BaseDirectory;
            if (args != null && args.Length > 0 && !string.IsNullOrEmpty(args[0]))
            {
                string cleanArg = args[0].Replace((char)34, ' ').Trim();
                while (cleanArg.EndsWith("\\") || cleanArg.EndsWith("/"))
                {
                    cleanArg = cleanArg.Substring(0, cleanArg.Length - 1);
                }
                if (Directory.Exists(cleanArg))
                {
                    baseDir = cleanArg;
                }
            }

            Application.Run(new MainForm(baseDir));
        }

