            private int m_dynamicScale = 54000;

            private int GetTimelineTotalFrames()
            {
                // 1. ???????????????????????????100% ????????????????????????????????? (??? 70,491 ???)??????????????????
                if (m_lockedTotalFrames > 0)
                    return m_lockedTotalFrames;

                // 2. ??????????????????????????????
                if (m_isEof != 0 && m_maxFrame > 1000)
                {
                    m_lockedTotalFrames = m_maxFrame;
                    return m_lockedTotalFrames;
                }

                // 3. ????????????????????? m_maxFrame ????????????????????????????????????????????????????????????
                while (m_maxFrame > (int)(m_dynamicScale * 0.90) && m_dynamicScale < 540000)
                {
                    m_dynamicScale += 36000;
                }
                return m_dynamicScale;
            }

            private void PnlTimeline_Paint(object sender, PaintEventArgs e)
            {
                Graphics g = e.Graphics;
                g.SmoothingMode = SmoothingMode.AntiAlias;
                int w = pnlTimeline.Width;
                int h = pnlTimeline.Height;

                int totalFrames = GetTimelineTotalFrames();
                if (totalFrames <= 0) totalFrames = 50400;

                using (SolidBrush bgBrush = new SolidBrush(Color.FromArgb(20, 22, 28)))
                {
                    g.FillRectangle(bgBrush, 0, 0, w, h);
                }

                float maxRatio = Math.Min(1.0f, Math.Max(0.0f, (float)m_maxFrame / (float)totalFrames));
                int maxW = (int)(w * maxRatio);
                if (maxW > 0)
                {
                    using (SolidBrush bufBrush = new SolidBrush(Color.FromArgb(52, 85, 105)))
                    {
                        g.FillRectangle(bufBrush, 0, 4, maxW, h - 8);
                    }
                }

                float curRatio = Math.Min(1.0f, Math.Max(0.0f, (float)m_curFrame / (float)totalFrames));
                int curW = (int)(w * curRatio);
                Color barColor = Color.FromArgb(0, 200, 130);
                if (m_stateCode == 1) barColor = Color.FromArgb(230, 175, 40);
                else if (m_stateCode == 2) barColor = Color.FromArgb(0, 195, 255);
                else if (m_stateCode == 3) barColor = Color.FromArgb(235, 95, 70);

                if (curW > 0)
                {
                    using (SolidBrush curBrush = new SolidBrush(barColor))
                    {
                        g.FillRectangle(curBrush, 0, 4, curW, h - 8);
                    }
                }

                using (Pen tickPen = new Pen(Color.FromArgb(80, 255, 255, 255), 1))
                {
                    for (int i = 1; i < 10; i++)
                    {
                        int tx = (w * i) / 10;
                        g.DrawLine(tickPen, tx, 2, tx, h - 2);
                    }
                }

                int knobX = Math.Min(w - 6, Math.Max(4, curW));
                using (SolidBrush knobBrush = new SolidBrush(Color.White))
                {
                    g.FillRectangle(knobBrush, knobX - 3, 1, 6, h - 2);
                }

                using (Pen borderPen = new Pen(Color.FromArgb(75, 85, 105), 1))
                {
                    g.DrawRectangle(borderPen, 0, 0, w - 1, h - 1);
                }
            }

            private void PnlTimeline_MouseDown(object sender, MouseEventArgs e)
            {
                if (m_isRecording)
                {
                    lblStatus.Text = Tr("\uD83C\uDFAC \u9304\u5F71\u9032\u884C\u4E2D\uFF0C\u6642\u9593\u8EF8\u5DF2\u9396\u5B9A\u4EE5\u4FDD\u8B77\u5F71\u7247\u5B8C\u6574\u6027\uFF01", "\uD83C\uDFAC Recording active, timeline seeking locked!");
                    return;
                }
                bool isReplayActive = m_hasStartedReplay || m_isMonitoring || (m_curFrame > 0 || m_maxFrame > 0);
                if (!isReplayActive) return;
                if (pnlTimeline.Width <= 0) return;
                float ratio = (float)e.X / (float)pnlTimeline.Width;
                if (ratio < 0.0f) ratio = 0.0f;
                if (ratio > 0.995f) ratio = 0.995f;

                int totalFrames = GetTimelineTotalFrames();
                int destFrame = (int)(ratio * totalFrames);
                SendIpcCommand("SEEK " + destFrame.ToString());
            }

            private string GetCmdDesc(string cmd)
            {
                if (cmd == "PAUSE") return Tr("\u66AB\u505C / \u7E7C\u7E8C\u5207\u63DB", "Toggle Pause / Play");
                if (cmd == "PCT 0") return Tr("\u56DE\u5230\u958B\u5C40 (0%)", "Back to start (0%)");
                if (cmd.StartsWith("PCT ")) return Tr("\u6309\u767E\u5206\u6BD4\u8DF3\u8F49 " + cmd.Substring(4) + "%", "Jump to " + cmd.Substring(4) + "%");
                if (cmd == "FFWD") return Tr("\u23E9 \u6301\u7E8F\u5FEB\u8F49 / \u6B63\u5E38\u901F\u5EA6 \u5207\u63DB", "\u23E9 Toggle Fast Forward / Normal");
                if (cmd == "PROBE_EOF") return Tr("\u26A1 \u63A2\u5E95\u7D50\u5C3E (\u76F4\u9054\u5168\u5834\u52DD\u8CA0\u4E26\u89E3\u9396\u767E\u5206\u6BD4)", "\u26A1 Probe to EOF (Unlock All)");
                if (cmd == "DELTA -1800") return Tr("\u23EA \u5FEB\u9000 30 \u79D2 (-1800 \u5E40)", "Rewind 30s (-1800f)");
                if (cmd == "DELTA 1800") return Tr("\u23E9 \u5FEB\u9032 30 \u79D2 (+1800 \u5E40)", "Fast Forward 30s (+1800f)");
                if (cmd == "DELTA -600") return Tr("\u5012\u5E36 10 \u79D2 (-600 \u5E40)", "Rewind 10s (-600f)");
                if (cmd == "DELTA 600") return Tr("\u5FEB\u9032 10 \u79D2 (+600 \u5E40)", "Fast Forward 10s (+600f)");
                if (cmd == "DELTA -180") return Tr("\u5012\u5E36 3 \u79D2 (-180 \u5E40)", "Rewind 3s (-180f)");
                if (cmd == "DELTA 180") return Tr("\u5FEB\u9032 3 \u79D2 (+180 \u5E40)", "Fast Forward 3s (+180f)");
                if (cmd == "DELTA -1") return Tr("\u55AE\u5E40\u5FAE\u8ABF (-1 \u5E40)", "Step Backward (-1f)");
                if (cmd == "DELTA 1") return Tr("\u55AE\u5E40\u524D\u9032 (+1 \u5E40)", "Step Forward (+1f)");
                if (cmd.StartsWith("SEEK ")) return Tr("\u6642\u9593\u8EF8\u5C0B\u8ECC\u81F3\u7B2C " + cmd.Substring(5) + " \u5E40", "Timeline seek to frame " + cmd.Substring(5));
                return Tr("\u5C0E\u64AD\u6307\u4EE4: " + cmd, "Command: " + cmd);
            }

            private void SendIpcCommand(string cmd)
            {
                try
                {
                    if (cmd == "FFWD")
                    {
                        m_isFfwdActive = !m_isFfwdActive;
                        if (m_isFfwdActive)
                        {
                            if (m_stateCode == 1 || m_stateCode == 3)
                            {
                                m_stateCode = 2;
                                lblPlayState.Text = Tr(">> \u23E9 \u5FEB\u901F\u524D\u9032\u4E2D...", ">> \u23E9 Fast Forwarding...");
                                lblPlayState.ForeColor = Color.FromArgb(80, 225, 255);
                            }
                        }
                        ApplyLanguage();
                    }
                    else if (cmd == "PROBE_EOF")
                    {
                        if (m_isFfwdActive)
                        {
                            m_isFfwdActive = false;
                            ApplyLanguage();
                        }
                        if (m_stateCode == 1 || m_stateCode == 3)
                        {
                            m_stateCode = 2;
                            lblPlayState.Text = Tr(">> \u26A1 \u5168\u901F\u63A2\u5E95\u8FFD\u8D95\u4E2D...", ">> \u26A1 Probing to EOF...");
                            lblPlayState.ForeColor = Color.FromArgb(80, 225, 255);
                        }
                    }
                    else if (cmd.StartsWith("SEEK") || cmd.StartsWith("PCT") || cmd.StartsWith("DELTA"))
                    {
                        if (m_isFfwdActive)
                        {
                            m_isFfwdActive = false;
                            ApplyLanguage();
                        }
                        if (cmd != "DELTA -1" && cmd != "DELTA 1")
                        {
                            m_lastResumeCmdSentTime = DateTime.Now;
                            if (m_stateCode == 1 || m_stateCode == 3)
                            {
                                m_stateCode = 2;
                            }
                        }
                    }
                    else if (cmd == "PAUSE")
                    {
                        if (m_isFfwdActive)
                        {
                            m_isFfwdActive = false;
                            ApplyLanguage();
                        }
                    }

                    foreach (string fbDir in GetTargetFbneoDirs())
                    {
                        try
                        {
                            string scriptsDir = Path.Combine(fbDir, "scripts");
                            if (!Directory.Exists(scriptsDir)) Directory.CreateDirectory(scriptsDir);
                            string cmdPath = Path.Combine(scriptsDir, "ipc_cmd.txt");
                            File.WriteAllText(cmdPath, cmd + "\n", Encoding.ASCII);
                        }
                        catch { }
                    }



                    string desc = GetCmdDesc(cmd);
                    bool isSeekCmd = cmd.StartsWith("PCT") || cmd.StartsWith("SEEK") || cmd.StartsWith("DELTA") || cmd == "PROBE_EOF" || cmd == "FFWD";
                    int targetFrame = -1;
                    string displayCmd = cmd;
                    if (cmd == "PROBE_EOF" || cmd == "FFWD")
                    {
                        targetFrame = (cmd == "PROBE_EOF") ? 999999 : m_curFrame;
                        m_lastSeekTargetFrame = -1;
                        m_lastSeekTime = DateTime.MinValue;
                    }
                    else if (cmd.StartsWith("PCT "))
                    {
                        int pct;
                        if (int.TryParse(cmd.Substring(4).Trim(), out pct))
                        {
                            int totalF = GetTimelineTotalFrames();
                            if (totalF > 0) targetFrame = (int)((double)totalF * (double)pct / 100.0);
                            m_lastSeekTargetFrame = targetFrame;
                            m_lastSeekTime = DateTime.Now;
                        }
                    }
                    else if (cmd.StartsWith("SEEK "))
                    {
                        int.TryParse(cmd.Substring(5).Trim(), out targetFrame);
                        m_lastSeekTargetFrame = targetFrame;
                        m_lastSeekTime = DateTime.Now;
                    }
                    else if (cmd.StartsWith("DELTA "))
                    {
                        int d;
                        if (int.TryParse(cmd.Substring(6).Trim(), out d))
                        {
                            double elapsedSinceLastSeek = (DateTime.Now - m_lastSeekTime).TotalSeconds;
                            int baseFrame = m_curFrame;
                            if (elapsedSinceLastSeek < 2.5 && m_lastSeekTargetFrame >= 0)
                            {
                                baseFrame = m_lastSeekTargetFrame;
                            }
                            targetFrame = baseFrame + d;
                            if (targetFrame < 0) targetFrame = 0;
                            int totalF = GetTimelineTotalFrames();
                            if (totalF > 0 && targetFrame > totalF) targetFrame = totalF;
                            m_lastSeekTargetFrame = targetFrame;
                            m_lastSeekTime = DateTime.Now;
                            cmd = "SEEK " + targetFrame;
                        }
                    }
                    else if (cmd == "PAUSE")
                    {
                        m_lastSeekTargetFrame = -1;
                        m_lastSeekTime = DateTime.MinValue;
                    }
                    CmdLogEntry entry = new CmdLogEntry()
                    {
                        TimeStr = DateTime.Now.ToString("HH:mm:ss"),
                        Cmd = displayCmd,
                        Desc = desc,
                        IsPending = isSeekCmd,
                        TargetFrame = targetFrame,
                        HasEnteredSeek = false,
                        SentTime = DateTime.Now,
                        StatusExtra = isSeekCmd ? Tr("[>> \u57F7\u884C\u8DF3\u8F49\u4E2D...]", "[>> Seeking...]") : ""
                    };
                    m_cmdEntries.Add(entry);
                    while (m_cmdEntries.Count > 1000) { m_cmdEntries.RemoveAt(0); }
                    RefreshCmdHistoryDisplay();

                    lblStatus.Text = Tr(
                        ">> \u5DF2\u767C\u9001\u5C0E\u64AD\u6307\u4EE4\uFF1A" + cmd,
                        ">> Sent Director Command: " + cmd
                    );
                    lblStatus.ForeColor = Color.FromArgb(120, 230, 255);
                }
                catch (Exception ex)
                {
                    lblStatus.Text = Tr(
                        "\u6307\u4EE4\u767C\u9001\u5931\u6557\uFF1A" + ex.Message,
                        "Command Failed: " + ex.Message
                    );
                    lblStatus.ForeColor = Color.Salmon;
                }
            }

            private static string FormatTime(int frames)
            {
                if (frames < 0) frames = 0;
                int totalSec = frames / 60;
                int mins = totalSec / 60;
                int secs = totalSec % 60;
                return string.Format("{0:D2}:{1:D2}", mins, secs);
            }

            private void RefreshDashboardText()
            {
                int totalF = GetTimelineTotalFrames();
                double pct = (totalF > 0) ? ((double)m_curFrame * 100.0 / (double)totalF) : 0.0;
                if (pct > 100.0) pct = 100.0;

                if (!m_isMonitoring && m_curFrame == 0 && m_maxFrame == 0)
                {
                    lblPlayState.Text = Tr(
                        "\u25A0 \u5C1A\u672A\u555F\u52D5\u56DE\u653E",
                        "\u25A0 Idle - Ready"
                    );
                    lblPlayState.ForeColor = Color.FromArgb(160, 170, 185);
                }
                else if (m_stateCode == 2)
                {
                    lblPlayState.Text = m_isEnglish
                        ? ">> Turbo Seeking..."
                        : ">> \u6975\u901F\u5FEB\u9032\u8FFD\u8D95\u4E2D...";
                    lblPlayState.ForeColor = Color.FromArgb(80, 225, 255);
                }
                else if (m_stateCode == 3 || (m_isEof != 0 && m_maxFrame > 1000 && m_curFrame >= m_maxFrame - 5))
                {
                    if (m_isFfwdActive)
                    {
                        m_isFfwdActive = false;
                        ApplyLanguage();
                    }
                    lblPlayState.Text = Tr(
                        "\u25A0 \u5168\u5C40\u64AD\u7562\u5B9A\u683C (\u53EF\u96A8\u6642\u9EDE\u64CA\u6309\u9215\u81EA\u7531\u5012\u5E36)",
                        "\u25A0 Match Ended (Click buttons or timeline to rewind)"
                    );
                    lblPlayState.ForeColor = Color.FromArgb(255, 140, 100);
                }
                else if (m_stateCode == 1)
                {
                    lblPlayState.Text = Tr(
                        "|| \u5DF2\u66AB\u505C",
                        "|| Paused"
                    );
                    lblPlayState.ForeColor = Color.FromArgb(255, 215, 80);
                }
                else if (m_isEof != 0 && m_curFrame < m_maxFrame - 10)
                {
                    lblPlayState.Text = Tr(
                        "\u25B6 \u6B77\u53F2\u5012\u5E36\u56DE\u653E\u4E2D",
                        "\u25B6 Rewind Replay Active"
                    );
                    lblPlayState.ForeColor = Color.FromArgb(100, 220, 255);
                }
                else
                {
                    lblPlayState.Text = Tr(
                        "\u25B6 \u6B63\u5E38\u64AD\u653E\u4E2D",
                        "\u25B6 Playing"
                    );
                    lblPlayState.ForeColor = Color.FromArgb(100, 255, 160);
                }

                if (!m_hasStartedReplay && m_curFrame == 0 && m_maxFrame == 0)
                {
                    lblTimeInfo.Text = m_isEnglish
                        ? "Time: --:--   |   Ready (Click Launch Replay to start)"
                        : "\u6642\u9593\uFF1A--:--   |   \u5C31\u7DD2 (\u9EDE\u64CA\u300C\u555F\u52D5\u56DE\u653E\u300D\u958B\u59CB)";
                }
                else if (m_lockedTotalFrames > 0)
                {
                    lblTimeInfo.Text = m_isEnglish
                        ? string.Format("Time: {0} / {1} ({2:F1}%)   |   Frame: {3} / {4} (Full Match Locked)",
                            FormatTime(m_curFrame), FormatTime(totalF), pct, m_curFrame, totalF)
                        : string.Format("\u6642\u9593\uFF1A{0} / {1} ({2:F1}%)   |   \u5E40\u6578\uFF1A{3} / {4} (\u5168\u5834\u5DF2\u89E3\u9396)",
                            FormatTime(m_curFrame), FormatTime(totalF), pct, m_curFrame, totalF);
                }
                else
                {
                    lblTimeInfo.Text = m_isEnglish
                        ? string.Format("Time: {0}   |   Frame: {1} (Buffered: {2})",
                            FormatTime(m_curFrame), m_curFrame, m_maxFrame)
                        : string.Format("\u6642\u9593\uFF1A{0}   |   \u5E40\u6578\uFF1A{1} (\u5DF2\u4E0B\u8F09\uFF1A{2} \u5E40)",
                            FormatTime(m_curFrame), m_curFrame, m_maxFrame);
                }

                // ?????????????????????????????????????????? (?????????/??????????????????????????????????????????)
                bool canUsePct = (m_isEof != 0 || m_lockedTotalFrames > 0);
                if (m_pctBtns != null)
                {
                    for (int i = 0; i < m_pctBtns.Length; i++)
                    {
                        if (m_pctBtns[i] != null && m_pctBtns[i].Enabled != canUsePct)
                        {
                            m_pctBtns[i].Enabled = canUsePct;
                            m_pctBtns[i].BackColor = canUsePct ? Color.FromArgb(38, 62, 82) : Color.FromArgb(28, 30, 36);
                            m_pctBtns[i].ForeColor = canUsePct ? Color.FromArgb(140, 230, 255) : Color.FromArgb(90, 95, 105);
                            m_pctBtns[i].FlatAppearance.BorderColor = canUsePct ? Color.FromArgb(60, 100, 130) : Color.FromArgb(50, 52, 60);
                        }
                    }
                }

                UpdateControlLockState();
                pnlTimeline.Invalidate();
            }

            private void UpdateControlLockState()
            {
                bool isReplayActive = m_hasStartedReplay || m_isMonitoring || (m_curFrame > 0 || m_maxFrame > 0);

                if (pnlTimeline != null && pnlTimeline.Enabled != isReplayActive)
                {
                    pnlTimeline.Enabled = isReplayActive;
                    pnlTimeline.Cursor = isReplayActive ? Cursors.Hand : Cursors.Default;
                }

                if (m_row1Btns != null)
                {
                    for (int i = 0; i < m_row1Btns.Length; i++)
                    {
                        var btn = m_row1Btns[i];
                        if (btn != null && btn.Enabled != isReplayActive)
                        {
                            btn.Enabled = isReplayActive;
                            if (!isReplayActive)
                            {
                                btn.BackColor = Color.FromArgb(30, 32, 38);
                                btn.ForeColor = Color.FromArgb(85, 90, 100);
                                btn.FlatAppearance.BorderColor = Color.FromArgb(45, 48, 55);
                                btn.Cursor = Cursors.Default;
                            }
                            else
                            {
                                bool isPauseBtn = (btn.Text.Contains("||") || btn.Text.Contains("Pause"));
                                btn.BackColor = isPauseBtn ? Color.FromArgb(215, 95, 35) : Color.FromArgb(46, 50, 62);
                                btn.ForeColor = Color.White;
                                btn.FlatAppearance.BorderColor = Color.FromArgb(70, 75, 90);
                                btn.Cursor = Cursors.Hand;
                            }
                        }
                    }
                }

                if (btnRewind30 != null && btnRewind30.Enabled != isReplayActive)
                {
                    btnRewind30.Enabled = isReplayActive;
                    btnRewind30.BackColor = isReplayActive ? Color.FromArgb(48, 54, 68) : Color.FromArgb(30, 32, 38);
                    btnRewind30.ForeColor = isReplayActive ? Color.FromArgb(220, 235, 255) : Color.FromArgb(85, 90, 100);
                    btnRewind30.FlatAppearance.BorderColor = isReplayActive ? Color.FromArgb(75, 85, 105) : Color.FromArgb(45, 48, 55);
                    btnRewind30.Cursor = isReplayActive ? Cursors.Hand : Cursors.Default;
                }

                if (btnForward30 != null && btnForward30.Enabled != isReplayActive)
                {
                    btnForward30.Enabled = isReplayActive;
