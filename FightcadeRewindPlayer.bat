            private bool VerifyFfmpegExecutable(string exePath)
            {
                try
                {
                    if (string.IsNullOrEmpty(exePath) || !File.Exists(exePath)) return false;
                    FileInfo fi = new FileInfo(exePath);
                    if (fi.Length < 200 * 1024) return false; // 排除小於 200KB 的空殼或損毀檔
                    if (!string.IsNullOrEmpty(m_cachedVerifiedFfmpegPath) &&
                        string.Equals(m_cachedVerifiedFfmpegPath, fi.FullName, StringComparison.OrdinalIgnoreCase) &&
                        m_cachedFfmpegWriteTime == fi.LastWriteTimeUtc)
                    {
                        return m_cachedFfmpegValid;
                    }
                    ProcessStartInfo psi = new ProcessStartInfo(fi.FullName, "-version");
                    psi.UseShellExecute = false;
                    psi.CreateNoWindow = true;
                    psi.RedirectStandardOutput = true;
                    psi.RedirectStandardError = true;
                    bool isValid = false;
                    using (Process p = Process.Start(psi))
                    {
                        if (p != null)
                        {
                            string output = p.StandardOutput.ReadToEnd();
                            p.WaitForExit(1500);
                            if (p.HasExited && p.ExitCode == 0 &&
                                !string.IsNullOrEmpty(output) &&
                                output.IndexOf("ffmpeg version", StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                isValid = true;
                            }
                        }
                    }
                    m_cachedVerifiedFfmpegPath = fi.FullName;
                    m_cachedFfmpegWriteTime = fi.LastWriteTimeUtc;
                    m_cachedFfmpegValid = isValid;
                    return isValid;
                }
                catch
                {
                    return false;
                }
            }
            private string GetFfmpegExecutablePath()
            {
                // 1. 使用者自行指定的路徑 (記憶於 tools\\ffmpeg_path.txt)
                try
                {
                    string cfgFile = GetCustomFfmpegConfigFile();
                    if (File.Exists(cfgFile))
                    {
                        string customPath = File.ReadAllText(cfgFile, Encoding.UTF8).Trim().Trim('"');
                        if (VerifyFfmpegExecutable(customPath))
                        {
                            return Path.GetFullPath(customPath);
                        }
                    }
                }
                catch { }
                // 2. [APP_DIR]\\tools\\ffmpeg.exe
                string p1 = Path.Combine(m_baseDir, "tools", "ffmpeg.exe");
                if (VerifyFfmpegExecutable(p1)) return Path.GetFullPath(p1);
                // 3. [APP_DIR]\\ffmpeg.exe
                string p2 = Path.Combine(m_baseDir, "ffmpeg.exe");
                if (VerifyFfmpegExecutable(p2)) return Path.GetFullPath(p2);
                // 4. 系統環境變數 PATH (解析為完整絕對路徑，確保 C 底層 GetFileAttributesA 100% 可存取)
                try
                {
                    string pathEnv = Environment.GetEnvironmentVariable("PATH");
                    if (!string.IsNullOrEmpty(pathEnv))
                    {
                        string[] dirs = pathEnv.Split(new char[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                        foreach (string d in dirs)
                        {
                            try
                            {
                                string cleanDir = d.Trim().Trim('"');
                                if (string.IsNullOrEmpty(cleanDir)) continue;
                                string candidate = Path.Combine(cleanDir, "ffmpeg.exe");
                                if (VerifyFfmpegExecutable(candidate))
                                {
                                    return Path.GetFullPath(candidate);
                                }
                            }
                            catch { }
                        }
                    }
                }
                catch { }
                return null;
            }
            private void SelectCustomFfmpegPath()
            {
                using (OpenFileDialog ofd = new OpenFileDialog())
                {
                    ofd.Title = Tr("請選擇 ffmpeg.exe 執行檔位置", "Select ffmpeg.exe Executable");
                    ofd.Filter = "ffmpeg.exe|ffmpeg.exe|Executable (*.exe)|*.exe";
                    ofd.CheckFileExists = true;
                    string curFp = GetFfmpegExecutablePath();
                    if (!string.IsNullOrEmpty(curFp) && File.Exists(curFp))
                    {
                        ofd.InitialDirectory = Path.GetDirectoryName(curFp);
                        ofd.FileName = Path.GetFileName(curFp);
                    }
                    else
                    {
                        string td = Path.Combine(m_baseDir, "tools");
                        if (!Directory.Exists(td))
                        {
                            try { Directory.CreateDirectory(td); } catch { }
                        }
                        ofd.InitialDirectory = Directory.Exists(td) ? td : m_baseDir;
                        ofd.FileName = "ffmpeg.exe";
                    }
                    if (ofd.ShowDialog() == DialogResult.OK)
                    {
                        m_cachedVerifiedFfmpegPath = null; // 強制重新實機驗證
                        if (VerifyFfmpegExecutable(ofd.FileName))
                        {
                            try
                            {
                                string td = Path.Combine(m_baseDir, "tools");
                                if (!Directory.Exists(td)) Directory.CreateDirectory(td);
                                File.WriteAllText(GetCustomFfmpegConfigFile(), ofd.FileName, Encoding.UTF8);
                            }
                            catch { }
                            UpdateFfmpegStatusUI();
                            MessageBox.Show(
                                Tr("✓ FFmpeg 引擎實機驗證通過！\n已記憶路徑：\n" + ofd.FileName + "\n\n「🚀 開始轉錄」按鈕已解鎖。",
                                   "✓ FFmpeg verified successfully!\nSaved path:\n" + ofd.FileName + "\n\nRecord button is now unlocked."),
                                Tr("FFmpeg 設定成功", "FFmpeg Ready"),
                                MessageBoxButtons.OK, MessageBoxIcon.Information);
                        }
                        else
                        {
                            UpdateFfmpegStatusUI();
                            MessageBox.Show(
                                Tr("所選檔案無法通過 FFmpeg 實機執行測試（可能並非 ffmpeg.exe 或檔案已損毀）！\n請選擇正確且完整的 ffmpeg.exe。",
                                   "The selected file failed FFmpeg execution verification!\nPlease select a valid ffmpeg.exe."),
                                Tr("FFmpeg 驗證失敗", "Verification Failed"),
                                MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        }
                    }
                }
            }
