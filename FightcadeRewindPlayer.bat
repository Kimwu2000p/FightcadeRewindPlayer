                    btnFfwd.FlatAppearance.BorderColor = isReplayActive ? (m_isFfwdActive ? Color.FromArgb(255, 120, 100) : Color.FromArgb(60, 115, 175)) : Color.FromArgb(45, 48, 55);
                    btnFfwd.Cursor = isReplayActive ? Cursors.Hand : Cursors.Default;
