            private void UpdateDashboardFromIpc(string line)
            {
                if (string.IsNullOrEmpty(line)) return;
                string[] parts = line.Trim().Split(new char[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length < 5) return;

                int curF, maxF, isEof, stCode, targetF;
                if (!int.TryParse(parts[0], out curF)) return;
                if (!int.TryParse(parts[1], out maxF)) return;
                if (!int.TryParse(parts[2], out isEof)) return;
                if (!int.TryParse(parts[3], out stCode)) return;
                if (!int.TryParse(parts[4], out targetF)) return;

                m_curFrame = curF;
                m_maxFrame = maxF;
                m_isEof = isEof;
                if ((stCode == 1 || stCode == 3) && (DateTime.Now - m_lastResumeCmdSentTime).TotalMilliseconds < 550)
                {
                    stCode = 2; // 保護期內忽略磁碟上尚未刷新的舊暫停狀態，防止 UI 閃回「已暫停」
                }
                m_stateCode = stCode;
                m_targetFrame = targetF;

                // æš«åœ/å¿«è½‰/å®Œè³½ è‡ªå‹•ç¡¬é«”ç´šéœéŸ³ç®¡ç† (åªæœ‰æ­£å¸¸ 1x æ’­æ”¾æ™‚æ‰ç™¼è²)



                if (isEof != 0 && maxF > 1000)
                {
                    m_lockedTotalFrames = maxF;
                }

                // ??????????????????????????????????????????/??????/????????????????????????
                bool hasPendingUpdated = false;
                foreach (var entry in m_cmdEntries)
                {
                    if (entry.IsPending)
                    {
                        if (stCode == 2)
                        {
                            entry.HasEnteredSeek = true;
                        }

                        double elapsedMs = (DateTime.Now - entry.SentTime).TotalMilliseconds;
                        bool arrived = false;

                        // ????????????????????????????????????????????? (stCode != 2) ????????????????????????????????????????????????
                        if (stCode != 2)
                        {
                            if (entry.TargetFrame >= 0)
                            {
                                bool isProbeCmd = (entry.Cmd == "PROBE_EOF");
                                if (isProbeCmd)
                                {
                                    // 探底專屬判定：必須真正到達結尾定格，或探底狀態結束切回定格/暫停，且至少經歷探底步進
                                    if ((isEof != 0 && curF >= maxF - 10) || (entry.HasEnteredSeek && stCode != 2))
                                    {
                                        arrived = true;
                                    }
                                }
                                else
                                {
                                    bool nearTarget = (Math.Abs(curF - entry.TargetFrame) <= 360);
                                    if (entry.TargetFrame > curF && (isEof != 0 && maxF > 1000 && curF >= maxF - 10))
                                    {
                                        nearTarget = true;
                                    }
                                    if ((nearTarget && elapsedMs > 200) || (entry.HasEnteredSeek && stCode != 2))
                                    {
                                        arrived = true;
                                    }
                                }
                            }
                            else
                            {
                                if (elapsedMs > 300)
                                {
                                    arrived = true;
                                }
                            }
                        }

                        if (arrived)
                        {
                            entry.IsPending = false;
                            entry.FinishTime = DateTime.Now;
                            string arrivalTimeStr = (entry.TargetFrame >= 0 && entry.TargetFrame < 500000) ? FormatTime(entry.TargetFrame) : FormatTime(curF);

                            entry.StatusExtra = Tr("[\u2713 \u8DF3\u8F49\u5B8C\u6210\uFF0C\u62B5\u9054 " + arrivalTimeStr + "]", "[\u2713 Completed, arrived " + arrivalTimeStr + "]");

                            hasPendingUpdated = true;
                        }
                    }
                }
                if (hasPendingUpdated)
                {
                    RefreshCmdHistoryDisplay();
                }

                RefreshDashboardText();
            }

