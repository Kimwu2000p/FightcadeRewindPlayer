            private void StartWatchdog()
            {
                if (m_isMonitoring) return;
                m_isMonitoring = true;
                m_watchdogThread = new Thread(() =>
                {
                    bool found = false;
                    for (int i = 0; i < 90; i++)
                    {
                        Process[] procs = Process.GetProcessesByName("fcadefbneo");
                        if (procs.Length > 0)
                        {
                            found = true;
                            try
                            {
                                string exePath = procs[0].MainModule.FileName;
                                if (!string.IsNullOrEmpty(exePath))
                                {
                                    m_activeFbneoDir = Path.GetDirectoryName(exePath);
                                }
                            }
                            catch { }
                            break;
                        }
                        Thread.Sleep(500);
                    }

                    if (found)
                    {
                        while (true)
                        {
                            Process[] procs = Process.GetProcessesByName("fcadefbneo");
                            if (procs.Length == 0) break;

                            try
                            {
                                IntPtr hLua = FindWindow(null, "Lua Script");
                                if (hLua != IntPtr.Zero)
                                {
                                    ShowWindow(hLua, 0);
                                    SetWindowPos(hLua, IntPtr.Zero, -32000, -32000, 0, 0, 0x0080 | 0x0010 | 0x0001);
                                }

                                string activeDir = !string.IsNullOrEmpty(m_activeFbneoDir) ? m_activeFbneoDir : GetFbneoDir();
                                string ipcStatePath = Path.Combine(activeDir, @"scripts\ipc_state.txt");

                                if (File.Exists(ipcStatePath))
                                {
                                    string content = "";
                                    using (FileStream fs = new FileStream(ipcStatePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                                    using (StreamReader sr = new StreamReader(fs, Encoding.ASCII))
                                    {
                                        content = sr.ReadLine();
                                    }
                                    if (!string.IsNullOrEmpty(content))
                                    {
                                        this.BeginInvoke((MethodInvoker)delegate
                                        {
                                            UpdateDashboardFromIpc(content);
                                        });
                                    }
                                }
                            }
                            catch { }

                            Thread.Sleep(100);
                        }
                    }

                    try
                    {
                        this.BeginInvoke((MethodInvoker)delegate
                        {
                            m_isMonitoring = false;
                            RestoreOriginalDll(true);
                            btnLaunch.Enabled = true;
                            lblPlayState.Text = Tr(
                                "\u25A0 \u6A21\u64EC\u5668\u5DF2\u95DC\u9589 (\u5B98\u65B9\u539F\u7248 DLL \u5DF2\u81EA\u52D5\u9084\u539F)",
                                "\u25A0 Emulator closed (Original DLL automatically restored)"
                            );
                            lblPlayState.ForeColor = Color.FromArgb(160, 170, 185);
                            lblStatus.Text = Tr(
                                "\u2713 \u6A21\u64EC\u5668\u5DF2\u95DC\u9589\uFF0C\u5B98\u65B9\u539F\u7248 DLL \u5DF2\u81EA\u52D5\u79D2\u7D1A\u9084\u539F\u5B8C\u6210\uFF01",
                                "\u2713 Emulator closed. Original official DLL has been restored!"
                            );
                            lblStatus.ForeColor = Color.FromArgb(100, 255, 150);
                        });
                    }
                    catch { }
                });
                m_watchdogThread.IsBackground = true;
                m_watchdogThread.Start();
            }

            private void RestoreOriginalDll(bool showMsg = true)
            {
                try
                {
                    bool anyRestored = false;
                    foreach (string fbneoDir in GetTargetFbneoDirs())
                    {
                        try
                        {
                            string dllPath = Path.Combine(fbneoDir, "ggponet.dll");
                            string realDllPath = Path.Combine(fbneoDir, "ggponet_real.dll");

                            if (File.Exists(realDllPath))
                            {
                                File.Copy(realDllPath, dllPath, true);
                                anyRestored = true;
                            }
                        }
                        catch { }
                    }

                    if (anyRestored)
                    {
                        if (showMsg)
                        {
                            lblStatus.Text = Tr(
                                "\u2713 \u5B98\u65B9\u539F\u7248 DLL \u5DF2\u6210\u529F\u9084\u539F\uFF01\u53EF\u5B89\u5FC3\u9032\u884C\u4E00\u822C\u7DDA\u4E0A\u5C0D\u6230\u3002",
                                "\u2713 Official original DLL restored! Safe for standard online matches."
                            );
                            lblStatus.ForeColor = Color.FromArgb(100, 255, 150);
                        }
                    }
                    else
                    {
                        if (showMsg)
                        {
                            lblStatus.Text = Tr(
                                "\u76EE\u524D\u5DF2\u662F\u5B98\u65B9\u539F\u7248\u72C0\u614B\u3002",
                                "Already in official original DLL state."
                            );
                            lblStatus.ForeColor = Color.LightGray;
                        }
                    }
                }
                catch (Exception ex)
                {
                    if (showMsg)
                    {
                        lblStatus.Text = Tr("\u9084\u539F\u5931\u6557\uFF1A", "Restore failed: ") + ex.Message;
                        lblStatus.ForeColor = Color.Red;
                    }
                }
            }

            private string ParseToFcadeUri(string input)
            {
                if (input.StartsWith("fcade://", StringComparison.OrdinalIgnoreCase))
                {
                    Match mf = Regex.Match(input, @"fcade://stream/[^/]+/[^/]+/([0-9\-]+)");
                    if (mf.Success) m_lastMatchId = mf.Groups[1].Value;
                    return input;
                }
                Match m = Regex.Match(input, @"replay\.fightcade\.com/([^/]+)/([^/]+)/([0-9\-]+)", RegexOptions.IgnoreCase);
                if (m.Success)
                {
                    string emu = m.Groups[1].Value;
                    string game = m.Groups[2].Value;
                    string matchId = m.Groups[3].Value;
                    m_lastMatchId = matchId;
                    return string.Format("fcade://stream/{0}/{1}/{2}.7,7100", emu, game, matchId);
                }
                return null;
            }

