            private class CmdLogEntry
            {
                public string TimeStr;
                public string Cmd;
                public string Desc;
                public bool IsPending;
                public string StatusExtra;
                public int TargetFrame = -1;
                public bool HasEnteredSeek = false;
                public DateTime SentTime = DateTime.Now;
                public DateTime FinishTime = DateTime.MinValue;

                public string ToLogString()
                {
                    string timeSpanStr = (FinishTime != DateTime.MinValue)
                        ? string.Format("{0} -> {1}", TimeStr, FinishTime.ToString("HH:mm:ss"))
                        : TimeStr;
                    if (string.IsNullOrEmpty(StatusExtra))
                    {
                        return string.Format("[{0}] {1} \u2500\u2500 {2}", timeSpanStr, Cmd, Desc);
                    }
                    else
                    {
                        return string.Format("[{0}] {1} \u2500\u2500 {2}  {3}", timeSpanStr, Cmd, Desc, StatusExtra);
                    }
                }
            }

            private System.Collections.Generic.List<CmdLogEntry> m_cmdEntries = new System.Collections.Generic.List<CmdLogEntry>();

            private void RefreshCmdHistoryDisplay()
            {
                if (txtCmdHistory != null && !txtCmdHistory.IsDisposed)
                {
                    System.Collections.Generic.List<string> lines = new System.Collections.Generic.List<string>();
                    foreach (var e in m_cmdEntries)
                    {
                        lines.Add(e.ToLogString());
                    }
                    txtCmdHistory.Text = string.Join("\r\n", lines.ToArray());
                    txtCmdHistory.SelectionStart = txtCmdHistory.Text.Length;
                    txtCmdHistory.ScrollToCaret();
                }
            }

